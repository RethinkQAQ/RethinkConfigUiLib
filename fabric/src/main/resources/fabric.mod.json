{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${modVersion}",
  "name": "${modName}",
  "description": "${modDescription}",
  "icon": "assets/rethink_config_ui_lib/icon.png",
  "authors": ["${modAuthor}"],
  "contact": {
    "sources": "https://github.com/${modGitHub}",
    "issues": "https://github.com/${modGitHub}/issues"
  },
  "license": "${modLicense}",
  "environment": "client",
  "accessWidener": "${modId}.accesswidener",
  "custom": {
    "modmenu": {
      "badges": ["library"],
      "update_checker": false
    }
  },
  "entrypoints": { "client": ["com.rethinkqaq.configui.fabric.RethinkConfigUiLibFabric"] },
  "mixins": ["rethink_config_ui_lib.mixins.json", "rethink_config_ui_lib.fabric.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabricLoaderMinVersion}",
    "minecraft": "${minecraftVersionRangeFabric}",
    "java": ">=${javaVersion}"
  }
}
